{
  "name": "cs-mono-6",
  "config": {
    "language": "C#",
    "compiler": "mono-6.12.0",
    "extensions": ["cs"],
    "compile": {
      "command": "judge-mcs-compile diagnostics.ndjson mcs solution.cs -out:solution.exe",
      "environ": [
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      ],
      "source": "solution.cs",
      "binary": "solution.exe",
      "diagnostics": "diagnostics.ndjson",
      "workdir": "/home/judge"
    },
    "execute": {
      "command": "mono solution.exe",
      "environ": [
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      ],
      "binary": "solution.exe",
      "workdir": "/home/judge"
    }
  }
}
